    "        set_b=io_authors_set,\n",
    "        set_c=boost_authors_set,\n",
    "        title=f\"Authors overlap (Key, IO, Boost), top_percentage {top_percentage}\",\n",
    "        set_labels=(\"Key\", \"IO\", \"Boost\"),\n",
    "        folder_output_path=folder_output_path,\n",
    "    )"
   ]
  },
